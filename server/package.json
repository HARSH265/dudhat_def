{
  "name": "dhudhat-def-server",
  "version": "1.0.0",
  "description": "Backend server for Dhudhat DEF website (Contact Form API)",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "nodemon --watch src --ext ts,json --exec \"tsc && node dist/server.js\"",
    "typecheck": "tsc --noEmit",
    "seed:admin": "tsc && node dist/scripts/seedAdmin.js",
    "seed:settings": "tsc && node dist/scripts/seedSettings.js",
    "migrate:leads": "tsc && node dist/scripts/migrateContactsToLeads.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.4.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/hpp": "^0.2.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.2",
    "nodemon": "^3.1.0",
    "typescript": "^7.0.2"
  }
}
