{
  "name": "dhudhat-def-server",
  "version": "1.0.0",
  "description": "Backend server for Dhudhat DEF website (Contact Form API)",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "nodemon --watch src --ext ts,json --exec \"tsc && node dist/server.js\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "mongoose": "^8.4.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^26.1.2",
    "nodemon": "^3.1.0",
    "typescript": "^7.0.2"
  }
}
