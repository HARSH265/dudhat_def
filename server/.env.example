# Copy to .env and fill in. Never commit .env.
# Full field reference: docs/DATABASE_ARCHITECTURE.md §7

# --- Core (required now) ---
# REQUIRED. If unset, the server assumes production and enforces production
# rules — missing secrets throw rather than falling back. Phase 1 review H2.
NODE_ENV=development
PORT=5000
MONGO_URI=
MONGO_DB_NAME=Dudhat_def

# --- CORS origins (required Phase 0) ---
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:5173

# --- Auth (required Phase 1) ---
# Generate each with: openssl rand -base64 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Salt for hashing IPs before storage. See docs/SECURITY_ARCHITECTURE.md §8
# REQUIRED outside development — there is no in-source default. A shared
# default would make the hashes reversible. Phase 1 review H3.
# Generate with: openssl rand -base64 24
IP_HASH_SALT=

# --- Media (required Phase 2) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Mail (required Phase 2 — lead notifications) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
